# 2026-10-20，wyy 新增：会后任务非敏感配置模板；默认关闭，不自动启用。
# 后续部署时复制至 /data/meet-deploy/env.d/postmeeting-common。
POSTMEETING_AGENT_ENABLED=false
# 可选试用邮箱 JSON 数组；非空时须所有收件人都在名单内，空数组不限制。
POSTMEETING_ALLOWED_RECIPIENT_EMAILS=[]
POSTMEETING_STATE_DIR=/var/lib/postmeeting
POSTMEETING_HOST_STATE_DIR=/data/meet-deploy/postmeeting-agent/state
POSTMEETING_RUNNER_IMAGE=lasuite-meet/postmeeting-runner:wyy-20261020
POSTMEETING_RUNNER_NETWORK=meet-postmeeting-egress
POSTMEETING_TASK_TIMEOUT_SECONDS=300
POSTMEETING_BATCH_TIMEOUT_SECONDS=900
POSTMEETING_MAX_OUTPUT_TOKENS=8192
POSTMEETING_ATTACHMENT_LIMIT_BYTES=18874368
